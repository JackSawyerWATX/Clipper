# API Configuration
API_BASE_URL=http://localhost:3000/api
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# MongoDB Configuration
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# For Local MongoDB (if you install MongoDB locally):
# MONGODB_URI=mongodb://localhost:27017/clipper-aviation

# Database name (if using local MongoDB)
MONGODB_DB_NAME=clipper-aviation

# Whether to use MongoDB in the app (true/false)
USE_MONGODB=true

# JWT Secret (for future authentication features)
JWT_SECRET=your-super-secret-jwt-key-here

# Email Configuration (for future features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# AWS Configuration (for future cloud storage features)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name