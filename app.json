{
  "expo": {
    "name": "Clipper Aviation Logistics",
    "slug": "clipper-aviation",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clipper.aviation.logistics"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#667eea"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.clipper.aviation.logistics"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "build": {
        "babel": {
          "include": ["@expo/vector-icons"]
        }
      },
      "meta": {
        "viewport": "width=device-width, initial-scale=1, shrink-to-fit=no",
        "themeColor": "#2196F3"
      },
      "config": {
        "firebase": {
          "measurementId": "G-XXXXXXXXXX"
        }
      }
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "2eb84ea5-0568-4a27-bb74-56833772b3b5"
      }
    },
    "owner": "clipper-aviation",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
